# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Email recipient ---
EMAIL_FROM=your-sender@example.com
EMAIL_TO=you@example.com

# --- Choose ONE: "sendgrid" or "smtp" ---
EMAIL_PROVIDER=smtp

# --- If using SendGrid (recommended for production) ---
SENDGRID_API_KEY=SG....

# --- If using SMTP (e.g. Gmail with App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

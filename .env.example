# --- Google Gemini ---
GEMINI_API_KEY=AIza...
# Options: gemini-2.0-flash | gemini-1.5-pro | gemini-2.5-pro
GEMINI_MODEL=gemini-2.0-flash

# --- Email recipient ---
EMAIL_FROM=your-sender@example.com
EMAIL_TO=you@example.com

# --- Choose ONE: "sendgrid" or "smtp" ---
EMAIL_PROVIDER=smtp

# --- If using SendGrid (recommended for production) ---
SENDGRID_API_KEY=SG....

# --- If using SMTP (e.g. Gmail with App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
